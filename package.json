{
  "name": "burgers-exe-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:public": "cross-env APP_TARGET=public vite",
    "dev:chekeo": "cross-env APP_TARGET=chekeo vite",
    "dev:internal": "cross-env APP_TARGET=chekeo vite",
    "build": "npm run build:public && npm run build:chekeo",
    "build:public": "cross-env APP_TARGET=public vite build",
    "build:chekeo": "cross-env APP_TARGET=chekeo vite build",
    "build:internal": "npm run build:chekeo",
    "typecheck": "tsc --noEmit",
    "preview:public": "npm run build:public && cross-env APP_TARGET=public vite preview",
    "preview:chekeo": "npm run build:chekeo && cross-env APP_TARGET=chekeo vite preview",
    "qa:visual": "playwright test --config=playwright.visual.config.ts",
    "db:v2:migrate:local": "wrangler d1 execute burgers-exe-menu-v2-preview --local --file=./migrations/0001_v2_menu_schema.sql",
    "db:v2:seed:local": "wrangler d1 execute burgers-exe-menu-v2-preview --local --file=./migrations/0002_v2_menu_seed.sql",
    "db:v2:orders:migrate:local": "wrangler d1 execute burgers-exe-menu-v2-preview --local --file=./migrations/0003_v2_orders_schema.sql",
    "db:v2:preview:migrate": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./migrations/0001_v2_menu_schema.sql",
    "db:v2:preview:seed": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./migrations/0002_v2_menu_seed.sql",
    "db:v2:preview:orders:migrate": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./migrations/0003_v2_orders_schema.sql",
    "db:v2:preview:reset-orders": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./scripts/preview-reset-orders.sql",
    "db:v2:produce:migrate:local": "wrangler d1 execute burgers-exe-menu-live --local --file=./migrations/0001_v2_menu_schema.sql",
    "db:v2:produce:seed:local": "wrangler d1 execute burgers-exe-menu-live --local --file=./migrations/0002_v2_menu_seed.sql",
    "db:v2:produce:orders:migrate:local": "wrangler d1 execute burgers-exe-menu-live --local --file=./migrations/0003_v2_orders_schema.sql",
    "db:v2:produce:migrate:remote": "wrangler d1 execute burgers-exe-menu-live --remote --file=./migrations/0001_v2_menu_schema.sql",
    "db:saas:local:migrate": "wrangler d1 execute burgers-exe-menu-v2-preview --local --file=./migrations/saas/0001_saas_control_plane.sql",
    "db:saas:local:seed": "wrangler d1 execute burgers-exe-menu-v2-preview --local --file=./migrations/saas/0002_saas_control_plane_seed.sql",
    "db:saas:preview:migrate": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./migrations/saas/0001_saas_control_plane.sql",
    "db:saas:preview:seed": "wrangler d1 execute burgers-exe-menu-v2-preview --remote --file=./migrations/saas/0002_saas_control_plane_seed.sql",
    "db:saas:produce:migrate": "wrangler d1 execute resto-saas-control-plane-production --remote --file=./migrations/saas/0001_saas_control_plane.sql",
    "db:saas:produce:seed": "wrangler d1 execute resto-saas-control-plane-production --remote --file=./migrations/saas/0002_saas_control_plane_seed.sql",
    "graphify": "graphify update"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-tabs": "^1.1.12",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.2",
    "hono": "^4.13.3",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260523.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "wrangler": "^4.19.1"
  }
}
